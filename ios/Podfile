# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Fix deployment target warnings and simulator build errors
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
    
    # Fix GCC_WARN_INHIBIT_ALL_WARNINGS being passed as a clang flag by BoringSSL-GRPC
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS']
          flags.gsub!('-GCC_WARN_INHIBIT_ALL_WARNINGS', '')
          file.settings['COMPILER_FLAGS'] = flags
        end
      end
    end
  end

  # Fix Apple Clang (Xcode 16) parse error in gRPC basic_seq.h files:
  # "A template argument list is expected after a name prefixed by the template keyword"
  # CallSeqFactory is NOT a template function, so removing the erroneous `template`
  # keyword fixes the build. Both gRPC-Core and gRPC-C++ ship the same buggy file.
  require 'fileutils'
  grpc_pods = ['gRPC-Core', 'gRPC-C++']
  grpc_pods.each do |pod_name|
    basic_seq_path = File.join(
      File.dirname(File.realpath(__FILE__)),
      "Pods/#{pod_name}/src/core/lib/promise/detail/basic_seq.h"
    )
    if File.exist?(basic_seq_path)
      content = File.read(basic_seq_path)
      patched = content.gsub(
        'Traits::template CallSeqFactory(',
        'Traits::CallSeqFactory('
      )
      if content != patched
        FileUtils.chmod('u+w', basic_seq_path)
        File.write(basic_seq_path, patched)
        puts "✅ Patched #{pod_name} basic_seq.h: removed erroneous 'template' keyword from CallSeqFactory"
      end
    end
  end

  project_path = 'Runner.xcodeproj'
  project = Xcodeproj::Project.open(project_path)
  project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end
  project.save
end
